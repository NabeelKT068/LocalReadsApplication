# Application Settings
PROJECT_NAME="Neighbourhood Book-Sharing Platform"
API_V1_STR="/api/v1"

# Database
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=book_sharing_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/book_sharing_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=YOUR_SUPER_SECRET_KEY_CHANGE_THIS_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days

# Business Logic Configuration
SHARING_RADIUS_KM=2
DEFAULT_BORROWING_PERIOD_DAYS=14
LATE_FEE_PER_DAY=1
CURRENCY=INR
